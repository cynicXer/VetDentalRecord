# DaySmart Vet (Vetter Software) API — copy to server/.env and fill in.
# These stay server-side and are never exposed to the browser.

# Stage root (no trailing slash). Sandbox shown; use the /api stage for production.
DAYSMART_BASE_URL=https://ulimfxq67h.execute-api.us-west-2.amazonaws.com/sandbox

# OAuth client credentials (client_credentials grant).
DAYSMART_CLIENT_ID=
DAYSMART_CLIENT_SECRET=

# The {apiKey} path segment issued for your clinic.
DAYSMART_API_KEY=
